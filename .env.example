# TikTunnel Control — sample environment
# Copy to .env (root) or config/env and edit. Precedence:
# real process environment > .env > config/env > config/settings.json defaults.
# Never put real passwords, tokens or UUIDs in this committed sample.

# Admin login (seeded into SQLite at startup; no first-run setup screen).
# Use a real unique password of at least 8 characters. CHANGE_ME is rejected.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_SET_A_REAL_PASSWORD

# Public VLESS endpoint supplied by Cloudcode
SERVER_HOST=vn-hn.cldcode.host
SERVER_PORT=23952
PROTOCOL=vless
MAX_USERS=3

# Optional: pin the sing-box release. Default is config/control.json -> singbox_version (1.14.5).
# Accepts "1.14.5" or "v1.14.5".
SINGBOX_VERSION=

# Optional: log rotation threshold in bytes (default 5242880 = 5 MiB)
TIKTUNNEL_MAX_LOG_BYTES=5242880

# Optional: set to 1 to run without the background watchdog
TIKTUNNEL_NO_WATCHDOG=0

# Optional: test credentials used by tests/control-test.js.
# Leave empty to let the test generate and store random credentials in tests/runtime/.
TIKTUNNEL_TEST_ADMIN_PASSWORD=
TIKTUNNEL_TEST_FRIEND_PASSWORD=

# Note: the admin API token is NOT read from here.
# It is generated once into config/secrets.env (chmod 600) by scripts/bootstrap.sh.
# Note: VPN mode, WS path, internal sing-box port and cookie_secure live in config/control.json.
